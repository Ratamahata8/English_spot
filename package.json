{
  "name": "english-spot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "check:content": "node --import tsx scripts/validate_content.ts",
    "check:audio": "python3 scripts/validate_audio.py",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "npm run typecheck && npm run check:content && npm run check:audio && npm run check:textbook && npm run check:workbook && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "format": "prettier --write src scripts/*.ts tests *.ts *.json *.html .github/workflows/*.yml",
    "format:check": "prettier --check src scripts/*.ts tests *.ts *.json *.html .github/workflows/*.yml",
    "check:textbook": "python3 scripts/textbook_audio.py",
    "check:workbook": "node --import tsx scripts/validate_workbook.ts && python3 scripts/workbook_audio.py"
  },
  "dependencies": {
    "dexie": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "espeak-ng": "1.0.2",
    "fake-indexeddb": "^6.2.0",
    "prettier": "3.6.2",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
