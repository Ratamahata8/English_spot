  "grammar": [
    {
      "id": "food-like",
      "title": "Like, likes и отрицание",
      "text": "I like — «мне нравится». После he или she к like добавляем s: He likes jelly. Чтобы сказать «не нравится» о себе, используй I do not like. Вопрос начинается с Do you или Does he. После does у like нет окончания s.",
      "examples": [
        "I like cheese.",
        "He likes jelly.",
        "I do not like milk.",
        "Do you like cheese?",
        "Does he like milk?"
      ]
    }
  ],
  "remedial": [
    {
      "id": "food-like",
      "title": "Like, likes и отрицание",
      "available": true,
      "explanation": "I like — «мне нравится». После he или she к like добавляем s: He likes jelly. Чтобы сказать «не нравится» о себе, используй I do not like.",
      "example": "I do not like milk.",
      "question": "Что подходит после He?",
      "answer": "likes",
      "options": ["like", "likes"]
