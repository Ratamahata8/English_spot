  "grammar": [
    {
      "id": "this-is",
      "title": "Называем предмет",
      "text": "This — это. Is связывает слова. My — мой. Book — книга. Вместе: «Это моя книга».",
      "examples": ["This is my book.", "What's this?", "It's a pen."]
    },
    {
      "id": "my-your",
      "title": "Знакомимся и говорим о своих вещах",
      "text": "My — мой, your — твой. Вопрос об имени значит «Как тебя зовут?». В ответе назови себя: «Меня зовут Сэм».",
      "examples": ["What's your name?", "My name is Sam.", "This is your book."]
    }
  ],
  "remedial": [
    {
      "id": "this-is",
      "title": "This is — знакомимся с предметом",
      "available": true,
      "explanation": "This — «это», предмет рядом. Is помогает соединить слова. Вместе This is — «Это…». Сначала укажи на предмет, потом назови его.",
      "example": "This is my ruler.",
      "question": "С чего начать фразу «Это моя линейка»?",
      "answer": "This is",
      "options": ["This is", "my"]
    },
    {
      "id": "my-your",
      "title": "My и your — чья это вещь?",
      "available": true,
      "explanation": "My — мой, моя, моё: вещь принадлежит тебе. Your — твой, твоя, твоё: ты говоришь о вещи друга. Окончание английского слова не меняется.",
      "example": "This is your book.",
      "question": "Как сказать «мой», если вещь твоя?",
      "answer": "my",
      "options": ["your", "my"]
    },
